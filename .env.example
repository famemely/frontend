# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_KEY=your_supabase_anon_key_here

# Google OAuth Configuration
EXPO_ANDROID_CLIENT_ID=your_android_client_id_here
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id_here
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=your_client_secret_here

# API Configuration
EXPO_PUBLIC_AUTH_REDIRECT_URI=exp://localhost:8081
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001

# Google Maps API Key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Debug Settings
EXPO_PUBLIC_DEBUG_AUTH=0
